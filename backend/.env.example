APP_ENV=development
APP_NAME=Restaurant Platform API

CLOVER_ENV=sandbox
CLOVER_BASE_URL=https://apisandbox.dev.clover.com
CLOVER_AUTH_MODE=sandbox_token
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=

# Required only for POST /api/orders. Use a merchant-owned Sandbox order type ID.
CLOVER_ORDER_TYPE_ID=
MENU_CACHE_TTL_SECONDS=60

# Explicit opt-in for launch/callback/completion routes; default remains disabled.
CLOVER_OAUTH_ENABLED=false
CLOVER_APP_ID=
CLOVER_APP_SECRET=

# Optional/blank in sandbox_token mode. When opting into OAuth, use exactly:
# CLOVER_OAUTH_AUTHORIZE_URL=https://sandbox.dev.clover.com/oauth/v2/authorize
# CLOVER_OAUTH_TOKEN_URL=https://apisandbox.dev.clover.com/oauth/v2/token
# CLOVER_OAUTH_REFRESH_URL=https://apisandbox.dev.clover.com/oauth/v2/refresh
CLOVER_OAUTH_AUTHORIZE_URL=
CLOVER_OAUTH_TOKEN_URL=
CLOVER_OAUTH_REFRESH_URL=

# HTTPS origin only: no path, userinfo, query, or fragment. Fill manually.
PUBLIC_BASE_URL=

# Fernet URL-safe base64 encoding of 32 random bytes. Keep outside the database.
# Generate and store securely yourself; this file deliberately contains no key.
CLOVER_TOKEN_ENCRYPTION_KEY=

# Customer QR tokens: a separate Fernet key, never the Clover OAuth key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TABLE_TOKEN_SIGNING_KEY=
# Optional comma-separated retired keys accepted during QR rotation.
TABLE_TOKEN_PREVIOUS_KEYS=
# Increment to revoke all previously printed tokens; reprint QR codes.
TABLE_TOKEN_VERSION=1
# Exact browser origin for development CORS, without a path or wildcard.
# Optional override for multiple explicit origins (comma-separated); takes precedence
# over FRONTEND_ORIGIN when set. Do not use wildcard tunnel domains.
# FRONTEND_ORIGINS=http://localhost:3000,https://your-exact-frontend.trycloudflare.com
FRONTEND_ORIGIN=http://localhost:3000
# Public browser origin used by the local QR generator; set to your HTTPS tunnel for phones.
FRONTEND_PUBLIC_URL=http://localhost:3000
# Protect legacy internal order/table-session routes when either frontend origin setting is set.
# Use a separate random value, never send this from the customer browser.
INTERNAL_API_KEY=

# Staff portal: store only a salted PBKDF2 hash, never a plaintext password.
# Generate locally with: .\.venv\Scripts\python.exe -m scripts.hash_admin_password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Separate random secret (32+ characters) used only to sign short-lived admin cookies.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
