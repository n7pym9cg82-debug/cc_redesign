NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Development only: set true when NEXT_PUBLIC_API_BASE_URL is an ngrok free-tier host.
NEXT_PUBLIC_NGROK_BYPASS_WARNING=false
# Optional exact HTTPS frontend tunnel origin for Next development assets.
FRONTEND_DEV_ORIGIN=
# Server-only same-origin proxy for the staff portal. Set at build time for production.
ADMIN_API_ORIGIN=http://127.0.0.1:8000
